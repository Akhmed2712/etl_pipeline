erDiagram

  %% ─── TARGET DIMENSION TABLE ──────────────────────────────────────────────

  fg_dim_pengemasan_barang {
    bigint  id                PK
    bigint  id_barang_paket
    varchar nama_barang
    varchar sediaan
    varchar adm_r
    varchar golongan
    varchar formularium
    varchar kategori
  }

  %% ─── SOURCE TABLES ───────────────────────────────────────────────────────

  dc_barang {
    bigint  id            PK
    bigint  id_sediaan    FK
    bigint  id_golongan   FK
    bigint  id_kategori   FK
    varchar nama_barang
    varchar adm_r
    varchar formularium
  }

  dc_kemasan_barang {
    bigint id         PK
    bigint id_barang  FK
  }

  dc_sediaan {
    bigint  id             PK
    varchar nama_sediaan
  }

  dc_golongan {
    bigint  id              PK
    varchar nama_golongan
  }

  dc_kategori_barang {
    bigint  id             PK
    varchar nama_kategori
  }

  dc_barang_paket {
    bigint  id          PK
    varchar nama_paket
  }

  %% ─── SOURCE RELATIONSHIPS ────────────────────────────────────────────────

  dc_barang ||--o{ dc_kemasan_barang  : "id = id_barang"
  dc_barang }o--|| dc_sediaan         : "id_sediaan = id"
  dc_barang }o--|| dc_golongan        : "id_golongan = id"
  dc_barang }o--|| dc_kategori_barang : "id_kategori = id"

  %% ─── ETL LINEAGE TO TARGET DIMENSION ─────────────────────────────────────

  %% Standard item flow
  dc_kemasan_barang }o--|| fg_dim_pengemasan_barang : "maps to standard item"

  %% Attribute enrichment
  dc_barang }o--|| fg_dim_pengemasan_barang : "nama_barang, adm_r, formularium"
  dc_sediaan }o--|| fg_dim_pengemasan_barang : "nama_sediaan → sediaan"
  dc_golongan }o--|| fg_dim_pengemasan_barang : "nama_golongan → golongan"
  dc_kategori_barang }o--|| fg_dim_pengemasan_barang : "nama_kategori → kategori"

  %% Package item flow
  dc_barang_paket }o--|| fg_dim_pengemasan_barang : "maps to package item"
