# ── Build index lengkap ────────────────────────────────────────────────────
def index_tables(mb, db_id):
    meta = mb.get(f"/api/database/{db_id}/metadata")
    by_name = {}   # tname -> {id, fields: {fname -> field_info}}
    by_id   = {}   # table_id -> tname
    for t in meta.get('tables', []):
        tname = t['name'].lower()
        by_id[t['id']] = tname
        fields_by_name = {}
        fields_by_id   = {}
        for f in t.get('fields', []):
            fname = f['name'].lower()
            info  = {
                'id': f['id'],
                'name': f['name'],
                'base_type': f.get('base_type', ''),
                'table_id': t['id'],
                'table_name': t['name'],
            }
            fields_by_name[fname] = info
            fields_by_id[f['id']] = info
        by_name[tname] = {'id': t['id'], 'fields_by_name': fields_by_name,
                          'fields_by_id': fields_by_id}
    return by_name, by_id

