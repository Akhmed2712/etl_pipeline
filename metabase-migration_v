# ── Remap GUI query (rekursif) ─────────────────────────────────────────────
def remap_query(obj):
    if isinstance(obj, dict):
        new_obj = {}
        for k, v in obj.items():
            if k == 'source-table' and isinstance(v, int):
                new_obj[k] = table_id_map.get(v, v)
            elif k == 'database' and v == ID_DATABASE_ASAL:
                new_obj[k] = ID_DATABASE_TUJUAN
            else:
                new_obj[k] = remap_query(v)
        return new_obj
    elif isinstance(obj, list):
        result = [remap_query(v) for v in obj]
        if len(result) >= 2 and result[0] == 'field' and isinstance(result[1], int):
            result[1] = field_id_map.get(result[1], result[1])
        return result
    return obj

# ── Remap template-tags (native SQL field filter) ──────────────────────────
def remap_template_tags(template_tags, src_table_id=None):
    """
    Otomatis remap field filter di template-tags.
    Strategi:
    1. Cari field berdasarkan dimension field ID → field_id_map
    2. Jika tidak ketemu, cari berdasarkan nama tag + nama tabel query
    3. Jika tidak ketemu, cari fuzzy berdasarkan nama tag di semua tabel tujuan
    """
    if not isinstance(template_tags, dict):
        return template_tags

    # Cari nama tabel asal dari src_table_id
    src_tname = src_by_id.get(src_table_id, '') if src_table_id else ''
    tgt_tname = find_tgt_table(src_tname) if src_tname else None

    new_tags = {}
    for tag_name, tag_val in template_tags.items():
        if not isinstance(tag_val, dict):
            new_tags[tag_name] = tag_val
            continue

        new_tag = dict(tag_val)
        tag_type = tag_val.get('type', '')

        if tag_type == 'dimension':
            dim = tag_val.get('dimension')
            old_fid = None

            if isinstance(dim, list) and len(dim) >= 2 and dim[0] == 'field' and isinstance(dim[1], int):
                old_fid = dim[1]

            new_fid = None

            # Strategi 1: field_id_map langsung
            if old_fid and old_fid in field_id_map:
                new_fid = field_id_map[old_fid]

            # Strategi 2: cari di tabel yang sama berdasarkan nama tag
            if not new_fid and tgt_tname:
                tgt_finfo = find_tgt_field(tgt_tname, tag_name.lower())
                if tgt_finfo:
                    new_fid = tgt_finfo['id']

            # Strategi 3: cari di source field info, lalu match ke target
            if not new_fid and old_fid and old_fid in src_field_flat:
                src_finfo = src_field_flat[old_fid]
                src_fname  = src_finfo['name'].lower()
                src_tbname = src_finfo['table_name'].lower()
                tgt_tbname = find_tgt_table(src_tbname)
                if tgt_tbname:
                    tgt_finfo = find_tgt_field(tgt_tbname, src_fname)
                    if tgt_finfo:
                        new_fid = tgt_finfo['id']

            # Strategi 4: fuzzy search nama tag di SEMUA tabel tujuan
            if not new_fid:
                for tname_t, tinfo_t in tgt_by_name.items():
                    tgt_finfo = find_tgt_field(tname_t, tag_name.lower())
                    if tgt_finfo:
                        new_fid = tgt_finfo['id']
                        fuzzy_log.append(
                            f"  Tag '{tag_name}' ditemukan di tabel tujuan '{tname_t}'"
                        )
                        break

            if new_fid:
                new_tag['dimension'] = ['field', new_fid] + (list(dim[2:]) if dim else [])
                new_tag['field-id']  = new_fid
                print(f"      🔗 Tag '{tag_name}': field {old_fid} → {new_fid}")
            else:
                # Hapus dimension agar tidak error, ubah jadi text filter biasa
                print(f"      ⚠️  Tag '{tag_name}': field {old_fid} tidak ditemukan → fallback ke text")
                new_tag.pop('dimension', None)
                new_tag.pop('field-id', None)
                new_tag['type'] = 'text'
                new_tag.pop('widget-type', None)

        new_tags[tag_name] = new_tag

    return new_tags

