# Buat flat lookup: src_field_id -> field info di source (termasuk table name)
src_field_flat = {}
for tname, tinfo in src_by_name.items():
    for fid, finfo in tinfo['fields_by_id'].items():
        src_field_flat[fid] = finfo

table_id_map = {}
field_id_map = {}
fuzzy_log    = []

def find_tgt_table(src_tname):
    """Cari tabel di target: exact match dulu, lalu fuzzy."""
    if src_tname in tgt_by_name:
        return src_tname
    matches = get_close_matches(src_tname, tgt_by_name.keys(), n=1, cutoff=0.6)
    if matches:
        fuzzy_log.append(f"  Tabel fuzzy: '{src_tname}' → '{matches[0]}'")
        return matches[0]
    return None

def find_tgt_field(tgt_tname, src_fname):
    """Cari field di target table: exact match dulu, lalu fuzzy."""
    tgt_fields = tgt_by_name[tgt_tname]['fields_by_name']
    if src_fname in tgt_fields:
        return tgt_fields[src_fname]
    matches = get_close_matches(src_fname, tgt_fields.keys(), n=1, cutoff=0.7)
    if matches:
        fuzzy_log.append(f"  Field fuzzy: '{src_fname}' → '{matches[0]}' (tabel: {tgt_tname})")
        return tgt_fields[matches[0]]
    return None

# Build mapping
for src_tname, src_tinfo in src_by_name.items():
    tgt_tname = find_tgt_table(src_tname)
    if not tgt_tname:
        continue
    table_id_map[src_tinfo['id']] = tgt_by_name[tgt_tname]['id']
    for src_fname, src_finfo in src_tinfo['fields_by_name'].items():
        tgt_finfo = find_tgt_field(tgt_tname, src_fname)
        if tgt_finfo:
            field_id_map[src_finfo['id']] = tgt_finfo['id']

print(f"✅ {len(table_id_map)} tabel, {len(field_id_map)} field berhasil di-map.")
